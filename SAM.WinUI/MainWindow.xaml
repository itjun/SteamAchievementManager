<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SAM.WinUIApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Fluent 2 外壳：左导航（无汉堡）+ 底部状态栏（发丝线分层）。
         Win11：Mica 生效时 ThemeService 会把根背景置空让材质贯通；
         其余情况由下方 ThemeResource 提供主题感知底色（随 RequestedTheme 正确解析）。
         （勿在代码里以 Application.Current.Resources 取主题画刷——那按应用级
          主题解析，元素级 RequestedTheme 对它无效，会把深色模式铺成浅底。） -->
    <Grid x:Name="RootGrid" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <NavigationView x:Name="NavView"
            Grid.Row="0"
            IsPaneToggleButtonVisible="False"
            IsBackButtonVisible="Collapsed"
            IsPaneOpen="True"
            OpenPaneLength="220"
            PaneDisplayMode="Left"
            IsSettingsVisible="False"
            Background="Transparent"
            SelectionChanged="OnNavigationSelectionChanged">

            <!-- 窗格头部：logo + 应用名（标题栏由 ExtendsContentIntoTitleBar 提供拖拽区） -->
            <NavigationView.PaneHeader>
                <StackPanel Orientation="Horizontal" Margin="16,12,16,14" Spacing="10">
                    <Image Source="/Assets/SAM.ico" Width="22" Height="22" VerticalAlignment="Center" />
                    <TextBlock Text="Steam 成就管理器"
                               FontSize="14" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                </StackPanel>
            </NavigationView.PaneHeader>

            <!-- Phase 4：类型分类动态菜单项（InfoBadge 计数）由此生成 -->
            <NavigationView.MenuItems>
                <NavigationViewItem Content="游戏库" Tag="library" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F1;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="设置" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <NavigationView.Content>
                <Frame x:Name="ContentFrame" />
            </NavigationView.Content>
        </NavigationView>

        <!-- 底部状态栏 -->
        <Border Grid.Row="1"
                Height="32"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusText, FallbackValue=就绪}"
                       Margin="16,0,16,0"
                       VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Border>
    </Grid>
</Window>
