<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SAM.WinUIApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Fluent 2 外壳：左导航（无汉堡）、应用名在窗格头部、页脚设置项。
         Win11 用 Mica（窗口保持透明分层）；Win10 由代码侧回退为纯色主题背景。 -->
    <Grid x:Name="RootGrid">
        <NavigationView x:Name="NavView"
            IsPaneToggleButtonVisible="False"
            IsBackButtonVisible="Collapsed"
            PaneDisplayMode="Left"
            OpenPaneLength="220"
            IsSettingsVisible="False">

        <NavigationView.PaneHeader>
            <TextBlock x:Name="PaneTitleText"
                Text="Steam 成就管理器"
                Margin="16,12,16,4"
                FontFamily="Segoe UI Variable Display"
                FontSize="14"
                FontWeight="SemiBold" />
        </NavigationView.PaneHeader>

        <NavigationView.MenuItems>
            <NavigationViewItem Content="游戏库" IsSelected="True" Tag="library">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE7FC;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <NavigationView.FooterMenuItems>
            <NavigationViewItem Content="设置" Tag="settings">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE713;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.FooterMenuItems>

        <Grid Padding="36,28,36,28">
            <StackPanel Spacing="8">
                <TextBlock Text="SAM.WinUI" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="脚手架验证窗口" Style="{StaticResource SubtitleTextBlockStyle}" />
            </StackPanel>
        </Grid>
        </NavigationView>
    </Grid>
</Window>
