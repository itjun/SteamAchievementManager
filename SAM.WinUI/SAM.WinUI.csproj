<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyTitle>Steam Achievement Manager</AssemblyTitle>
    <Company>Gibbed</Company>
    <Authors>Gibbed</Authors>
    <Description>WinUI 3 client for the Steam Achievement Manager.</Description>
    <Copyright>Copyright © Gibbed 2019</Copyright>
  </PropertyGroup>
  <PropertyGroup>
    <Version>7.1.0</Version>
    <AssemblyVersion>7.1.0.0</AssemblyVersion>
    <FileVersion>7.1.0.0</FileVersion>
  </PropertyGroup>
  <PropertyGroup>
    <RepositoryUrl>https://github.com/gibbed/SteamAchievementManager/</RepositoryUrl>
    <RepositoryType>Git</RepositoryType>
  </PropertyGroup>
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <!-- 程序集名 SAM.WinUI；根命名空间避开 SAM.WinUI（防命名空间遮蔽，同 WPF 教训）。 -->
    <RootNamespace>SAM.WinUIApp</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- C# 13：[ObservableProperty] 分部属性所需（WinUI 3 的 WinRT/AOT 安全写法）。 -->
    <LangVersion>preview</LangVersion>
    <!-- x64：与全解决方案一致（steamclient64.dll）。 -->
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <!-- 未打包 + 自包含 WinAppRuntime：便于衍生 SAM.Worker 子进程与
         从 Steam 目录取 LoadLibrary，免 MSIX 身份与虚拟化。 -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ApplicationIcon>Assets\SAM.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Assets\SAM.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SAM.Core\SAM.Core.csproj" />
    <!-- SAM.Worker.exe 随主程序部署（统计/探测子进程宿主）。 -->
    <ProjectReference Include="..\SAM.Worker\SAM.Worker.csproj" ReferenceOutputAssembly="false" OutputItemType="Content" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- WinUI 未打包发布的已知缺口：dotnet publish 不输出应用 PRI（XAML 资源索引），
       缺它则所有 XAML InitializeComponent 抛 XamlParseException（build 输出有、publish 输出无）。 -->
  <Target Name="CopyAppPriToPublishDirectory" AfterTargets="Publish"
          Condition="Exists('$(OutDir)$(AssemblyName).pri')">
    <Copy SourceFiles="$(OutDir)$(AssemblyName).pri" DestinationFolder="$(PublishDir)" />
  </Target>

</Project>
