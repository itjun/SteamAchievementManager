<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SAM.WinUIApp.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Fluent 2 设置页：字阶层级 + SurfaceCard 分卡 + 分段控件主题三选 -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,24,36,28" MaxWidth="760" HorizontalAlignment="Left" Spacing="4">

            <TextBlock Text="设置" Style="{StaticResource TitleTextBlockStyle}" />

            <!-- 外观 -->
            <TextBlock Text="外观" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,20,0,8" />

            <Border Style="{StaticResource SurfaceCard}" Padding="18,14,18,16">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="主题" Style="{StaticResource BodyTextBlockStyle}" />
                        <TextBlock Text="深色模式适合配合 Steam 使用；跟随系统将随 Windows 外观自动切换。"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   TextWrapping="Wrap" Margin="0,0,24,0" />
                    </StackPanel>

                    <!-- 分段控件（WASDK 2.x 无原生 Segmented，沿用分段 RadioButton 方案） -->
                    <Border Grid.Column="1" Style="{StaticResource SegmentedGroup}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource SegmentedItem}" Content="跟随系统" GroupName="ThemeMode"
                                         IsChecked="{Binding IsSystemTheme, Mode=TwoWay}" />
                            <RadioButton Style="{StaticResource SegmentedItem}" Content="浅色" GroupName="ThemeMode"
                                         IsChecked="{Binding IsLightTheme, Mode=TwoWay}" />
                            <RadioButton Style="{StaticResource SegmentedItem}" Content="深色" GroupName="ThemeMode"
                                         IsChecked="{Binding IsDarkTheme, Mode=TwoWay}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 关于 -->
            <TextBlock Text="关于" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,24,0,8" />

            <Border Style="{StaticResource SurfaceCard}" Padding="18,14,18,16">
                <StackPanel Spacing="6">
                    <TextBlock Text="Steam 成就管理器（WinUI 版）" Style="{StaticResource BodyTextBlockStyle}" />
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap">
                        <Run Text="版本 7.1.0 · 基于 .NET 8 + WinUI 3 / Windows App SDK（Fluent 2）"/><LineBreak/>
                        <Run Text="统计与探测子进程：SAM.Worker；Steam 互操作：steamclient64.dll（x64）。"/>
                    </TextBlock>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
