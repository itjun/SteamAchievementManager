<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Company>Gibbed</Company>
    <Authors>Gibbed</Authors>
    <Description></Description>
    <Copyright>Copyright © Gibbed 2019</Copyright>
  </PropertyGroup>
  <PropertyGroup>
    <Version>7.0.0</Version>
    <AssemblyVersion>7.0.0.0</AssemblyVersion>
    <FileVersion>7.0.0.0</FileVersion>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationIcon>Pink.ico</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup>
    <RepositoryUrl>https://github.com/gibbed/SteamAchievementManager/</RepositoryUrl>
    <RepositoryType>Git</RepositoryType>
  </PropertyGroup>
  <PropertyGroup>
    <!-- net48 为历史保留目标（旧 WinForms 已删，现无消费者，源代码零差异）；
         net8.0-windows: 供 SAM.Core / SAM.Worker / SAM.WinUI 使用。 -->
    <TargetFrameworks>net48;net8.0-windows</TargetFrameworks>
    <LangVersion>9.0</LangVersion>
    <!-- x64：加载 Steam 自带的 steamclient64.dll（不再兼容 32 位系统）。 -->
    <Platforms>x64</Platforms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
</Project>