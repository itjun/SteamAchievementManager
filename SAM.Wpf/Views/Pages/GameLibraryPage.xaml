<Page x:Class="SAM.WpfApp.Views.Pages.GameLibraryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:SAM.WpfApp.Views.Controls"
      xmlns:vm="clr-namespace:SAM.WpfApp.ViewModels"
      Title="游戏">

    <!-- Phase 6 统一导航：内容区在 游戏库 ↔ 游戏详情 间切换（MainViewModel.CurrentView） -->
    <ContentControl Content="{Binding CurrentView}">
        <ContentControl.Resources>
            <DataTemplate DataType="{x:Type vm:GameLibraryViewModel}">
                <controls:GameLibraryView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:GameDetailViewModel}">
                <controls:GameDetailView />
            </DataTemplate>
        </ContentControl.Resources>
    </ContentControl>
</Page>
