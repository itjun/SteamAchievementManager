<Page x:Class="SAM.WpfApp.Views.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="设置">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,16" MaxWidth="640" HorizontalAlignment="Left">

            <TextBlock Text="外观" FontSize="20" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock Text="主题" FontSize="13" Margin="0,16,0,4"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock Text="深色模式适合配合 Steam 使用；跟随系统将随 Windows 外观自动切换。"
                       FontSize="12" Margin="0,0,0,8"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <ComboBox ItemsSource="{Binding ThemeOptions}"
                      SelectedItem="{Binding SelectedThemeOption}"
                      DisplayMemberPath="Label"
                      MinWidth="220" HorizontalAlignment="Left" />

            <TextBlock Text="关于" FontSize="20" FontWeight="SemiBold" Margin="0,28,0,12"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock FontSize="13" LineHeight="22"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                <Run Text="Steam 成就管理器（重构版） 7.1.0"/><LineBreak/>
                <Run Text="基于 .NET 8 + WPF UI，正在按阶段替换旧版 WinForms 客户端。"/><LineBreak/>
                <Run Text="旧版 SAM.Picker / SAM.Game 在功能对齐前保持可用。"/>
            </TextBlock>

        </StackPanel>
    </ScrollViewer>
</Page>
