<ui:FluentWindow x:Class="SAM.WpfApp.Views.Windows.AddGameWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="添加游戏"
                 Width="420" SizeToContent="Height"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">

    <StackPanel Margin="24,20,24,20">
        <TextBlock Text="手动添加游戏"
                   FontSize="18" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        <TextBlock Text="输入 App ID 直接显示该游戏（需要拥有该游戏）。刷新可恢复完整列表。"
                   FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <ui:TextBox x:Name="AppIdTextBox"
                    Margin="0,16,0,0"
                    PlaceholderText="例如 480"
                    ClearButtonEnabled="True" />
        <TextBlock x:Name="InvalidHintText"
                   Text="请输入有效的 App ID（正整数）。"
                   FontSize="12" Margin="0,6,0,0"
                   Foreground="{DynamicResource SystemFillColorCautionBrush}"
                   Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <ui:Button Content="取消" MinWidth="88" Click="OnCancelClick" />
            <ui:Button Content="确定" MinWidth="88" Margin="8,0,0,0" Appearance="Primary" Click="OnOkClick" />
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
