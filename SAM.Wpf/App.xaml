<Application x:Class="SAM.WpfApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:SAM.WpfApp.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />

            <!-- 家庭共享状态章配色（浅色基线；ThemeService 订阅主题切换改写深色值）：
                 文本对比度按 WCAG 校准，浅 #9A5B14≈4.7:1 / 深 #E8A33D≈4.6:1 -->
            <SolidColorBrush x:Key="FamilySharedTextBrush" Color="#FF9A5B14" />
            <SolidColorBrush x:Key="FamilySharedBackgroundBrush" Color="#1FE8A33D" />
            <SolidColorBrush x:Key="FamilySharedBorderBrush" Color="#33E8A33D" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
